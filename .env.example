# 应用配置
APP_ENV=development
APP_DEBUG=true
# 应用密钥（用途：加密存储的密码、加密的 JWT 令牌）
APP_KEY=20260131@sports-api

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sports_api
DB_USERNAME=root
DB_PASSWORD=123456
DB_CHARSET=utf8mb4

# JWT 配置（小程序API 鉴权） 
JWT_SECRET=20260131@sports-api
JWT_EXPIRE=7200

# 日志配置
LOG_LEVEL=debug

# OSS 配置（可选，不配置则上传到本地 public/uploads）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=your-endpoint
OSS_BASE_URL=your-base-url