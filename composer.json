{
    "name": "sports-api/framework",
    "description": "体育 API 快速开发框架 - 支持管理端、单位端、小程序API",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "slim/http": "^1.3",
        "illuminate/database": "^8.83",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^2.8",
        "firebase/php-jwt": "^6.4",
        "respect/validation": "^2.2",
        "php-di/php-di": "^6.4",
        "aliyuncs/oss-sdk-php": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/router.php",
        "start-admin": "php -S localhost:8081 -t public public/router.php",
        "start-unit": "php -S localhost:8082 -t public public/router.php",
        "start-api": "php -S localhost:8083 -t public public/router.php"
    }
}
